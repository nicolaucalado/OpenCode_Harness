# Copie para .env e preencha. NUNCA comite o .env.
# O .env serve para uso local; no GitHub Actions use Settings > Secrets.

# Provider usado pelo modelo do dia a dia e pela revisão de PR.
# Preencha apenas o que for usar (o modelo escolhido define qual é necessário).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENCODE_API_KEY=

# Alternativa ao OAuth do MCP do GitHub (token fine-grained, somente leitura).
# Não é necessário se você autenticar pelo /mcps.
GITHUB_PERSONAL_ACCESS_TOKEN=
